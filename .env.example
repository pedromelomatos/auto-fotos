# Servidor de imagens
IMAGENS_BASE_URL=https://servidor.exemplo/FABRICANTE/
# Substitua a URL acima pela pasta real, com barra final.
# Use false somente se o servidor de imagens tiver certificado invalido.
SERVIDOR_VERIFY_SSL=true

# API Bling v3. Escrita de imagens continua bloqueada por flags no comando.
BLING_API_BASE_URL=https://api.bling.com.br/Api/v3
BLING_ENABLE_JWT=true
BLING_REDIRECT_URI=http://127.0.0.1:8765/callback
BLING_ACCESS_TOKEN=

# OAuth usado tanto na consulta quanto na autorizacao do escopo de imagens.
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REFRESH_TOKEN=
# Preenchido automaticamente pelo fluxo OAuth.
BLING_TOKEN_EXPIRES_AT=
